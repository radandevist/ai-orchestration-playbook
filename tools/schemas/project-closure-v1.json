{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-orchestration-playbook/schemas/project-closure-v1.json",
  "title": "PR Closure Project Configuration",
  "description": "Fail-closed versioned project configuration for the PR closure gate. Path safety and component rules JSON Schema cannot express are enforced in Python.",
  "$comment": "Generated from tools/pr_closure/contract.py by PYTHONPATH=tools python3 -m pr_closure.contract - never hand-edit. Residual semantics JSON Schema cannot express are enforced in Python and are documented verbatim: exact_integer_types: integer-valued JSON numbers such as schema_version 1.0, infra_retry_budget 1.0, heavy_job_limit 1.0, or verification_command_timeout_seconds 1.0 satisfy JSON Schema integer/const semantics, while the Python gate requires exact int values and rejects floats and booleans.; forbidden_temporary_paths: repo_path and closure_state_dir must resolve to durable absolute paths outside /tmp and the session job area; JSON Schema can only express the leading-slash requirement, so this schema accepts /tmp roots the Python gate rejects.; unsafe_project_component: the project name must be a single safe path component (no slash, backslash, NUL, or surrounding whitespace, and not '.' or '..'); JSON Schema cannot exclude '.'/'..'/NUL, so this schema accepts spellings the Python gate rejects.; nul_command_string: configured command strings must not contain NUL bytes because the subprocess argv contract cannot carry them; JSON Schema's \\S pattern accepts NUL, so this schema accepts spellings the Python gate rejects.; project_model_registry: canonical model and launcher-registry membership for project routes is a Python registry lookup; JSON Schema can constrain exact spelling shape but cannot reject an unknown model or endpoint identity.; project_route_policy: project route uniqueness, same-family exception concordance, forbidden reviewer families, and staged/enforced cross-object policy relations are Python checks; JSON Schema cannot compare those normalized values.; ci_live_checks_subset: ci_live_pr_checks must be a subset of ci_required_checks; JSON Schema cannot express a dynamic array-subset relationship, so it validates the member shape and uniqueness while Python enforces the cross-field subset.",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "repository",
    "repo_path",
    "default_branch",
    "closure_state_dir",
    "local_review_ready_commands",
    "closure_acceptance_commands",
    "infra_retry_budget",
    "stagnation_budget_minutes",
    "heavy_job_limit",
    "verification_command_timeout_seconds",
    "tracking_projection",
    "ci_required_checks",
    "ci_live_pr_checks",
    "ci_required_checks_source",
    "ci_live_pr_workflow"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "project": {
      "type": "string",
      "pattern": "^[^/\\\\\\s]+$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+(?![\\s\\S])"
    },
    "repo_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/\\S"
    },
    "default_branch": {
      "type": "string",
      "pattern": "^\\S+$"
    },
    "closure_state_dir": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/\\S"
    },
    "local_review_ready_commands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "closure_acceptance_commands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "infra_retry_budget": {
      "type": "integer",
      "minimum": 1
    },
    "stagnation_budget_minutes": {
      "type": "integer",
      "minimum": 1
    },
    "heavy_job_limit": {
      "type": "integer",
      "const": 1
    },
    "verification_command_timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "tracking_projection": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "ci_required_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "ci_live_pr_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "ci_required_checks_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pull_request",
        "merge_group",
        "push"
      ],
      "properties": {
        "pull_request": {
          "const": "candidate_tip"
        },
        "merge_group": {
          "const": "event_tip"
        },
        "push": {
          "const": "event_tip"
        }
      }
    },
    "ci_live_pr_workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "action"
      ],
      "properties": {
        "path": {
          "const": ".github/workflows/ci.yml"
        },
        "action": {
          "const": "pull_request"
        }
      }
    },
    "model_routes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modelRoute"
      }
    },
    "review_policy": {
      "$ref": "#/$defs/reviewPolicy"
    }
  },
  "oneOf": [
    {
      "properties": {
        "model_routes": {
          "maxItems": 0
        },
        "review_policy": {
          "properties": {
            "mode": {
              "type": "null"
            },
            "owner_authorization": {
              "type": "null"
            },
            "forbidden_reviewer_families": {
              "maxItems": 0
            },
            "same_family_exceptions": {
              "maxItems": 0
            }
          }
        }
      }
    },
    {
      "required": [
        "model_routes",
        "review_policy"
      ],
      "properties": {
        "model_routes": {
          "minItems": 1
        },
        "review_policy": {
          "required": [
            "mode",
            "owner_authorization"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "staged",
                "enforced"
              ]
            },
            "owner_authorization": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "modelRoute": {
      "type": "object",
      "required": [
        "id",
        "implementer_invocation_model",
        "implementer_model",
        "implementer_runner",
        "launcher_registry_version",
        "registry_version",
        "reviewer_invocation_model",
        "reviewer_model",
        "reviewer_runner",
        "same_family_policy_id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*(?![\\s\\S])"
        },
        "registry_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "launcher_registry_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "implementer_model": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*(?![\\s\\S])"
        },
        "implementer_runner": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "implementer_invocation_model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reviewer_model": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*(?![\\s\\S])"
        },
        "reviewer_runner": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reviewer_invocation_model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "same_family_policy_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]*(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "reviewPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "staged",
                "enforced"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "owner_authorization": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "forbidden_reviewer_families": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "same_family_exceptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sameFamilyException"
          }
        }
      }
    },
    "sameFamilyException": {
      "type": "object",
      "required": [
        "id",
        "implementer_family",
        "owner_authorization",
        "rationale",
        "registry_version",
        "required_for_authorized_family",
        "reviewer_model"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*(?![\\s\\S])"
        },
        "registry_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "implementer_family": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reviewer_model": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*(?![\\s\\S])"
        },
        "required_for_authorized_family": {
          "type": "boolean"
        },
        "owner_authorization": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  }
}
