#!/usr/bin/env python3
"""Fail-closed PR closure gate CLI entry point.

Self-contained: adds the ``tools`` directory holding this script to
``sys.path`` so the ``pr_closure`` package is importable without a configured
``PYTHONPATH``.
"""
from __future__ import annotations

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from pr_closure.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
